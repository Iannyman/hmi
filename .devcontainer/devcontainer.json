{
  "name": "${localWorkspaceFolderBasename}",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/app",
  "workspaceMount": "source=${localWorkspaceFolder},target=/app,type=bind",
  "mounts": [
    "source=${localWorkspaceFolderBasename}_devcontainer_node_modules,target=${containerWorkspaceFolder}/node_modules,type=volume",
    "source=${localEnv:HOME}/.claude,target=/root/.claude,type=bind,consistency=cached"
  ],
  "forwardPorts": [
    4000
  ],
  "postCreateCommand": "npm install --legacy-peer-deps && ln -sfn /root/.claude/projects/-opt-apps-hmi /root/.claude/projects/-app",
  "runArgs": [
    "--publish",
    "4000:3000",
    "--name=dev-${localWorkspaceFolderBasename}",
    "--env-file",
    ".env"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss",
        "ms-vscode.vscode-typescript-next",
        "anthropic.claude-code"
      ],
      "settings": {
        "js/ts.tsdk.path": "/app/node_modules/typescript/lib"
      }
    }
  }
}